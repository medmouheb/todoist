# Production settings. Copy to .env.prod on the server and fill in every value marked REQUIRED.
# Never commit .env.prod.

# REQUIRED: the address people will use, without https://.
# No domain? Use your server's public IP with sslip.io, e.g. for 129.151.10.20: 129-151-10-20.sslip.io
DOMAIN=


# REQUIRED: a long random password. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=doable
POSTGRES_USER=doable

# REQUIRED: at least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Time zone used when a request doesn't say which day it is (e.g. Europe/Paris, Africa/Tunis).
TZ=UTC

# Email for password resets, login links and invites. Without it the app works,
# but those emails are not sent. Brevo's free plan (300 emails/day) settings:
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
# Must be a sender address you verified with your email provider.
MAIL_FROM=Doable <you@example.com>
