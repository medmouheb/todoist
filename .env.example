# Copy to .env and change what you need. Everything has a working default.
POSTGRES_DB=doable
POSTGRES_USER=doable
POSTGRES_PASSWORD=doable

# At least 32 characters. Use a long random value anywhere other than your own machine.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Host ports
FRONTEND_PORT=4200
BACKEND_PORT=8080
DB_PORT=5432
ADMINER_PORT=8081
MAILPIT_PORT=8025

# Where links in emails point. Change it if the app is served from another address.
APP_URL=http://localhost:4200

# Optional: send real email from a Gmail account instead of catching it in Mailpit.
# See deploy/GMAIL.md for how to get these three values.
# MAIL_FROM=Doable <you@gmail.com>
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
